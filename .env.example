# ============================================
# 「明礼 MingLi」环境变量配置示例
# 复制为 .env 并填入真实值
# ============================================

# ---- 选择 LLM 提供商 ----
# 可选: aliyun_bailian / minimax / deepseek / qwen / doubao
LLM_PROVIDER=aliyun_bailian

# ---- DeepSeek 配置 ----
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 通义千问 (阿里云百炼官方 API) 配置 ----
# 申请地址: https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- 阿里云百炼 (token-plan 订阅 Key) 配置 ★ 推荐 ----
# 订阅管理: https://bailian.console.aliyun.com/#/sub-agent/token-plan
# token-plan Key 与按量计费 Key 不互通，仅可在订阅套餐内调用指定模型
# 端点固定为 token-plan 兼容模式（OpenAI 协议）
ALIYUN_BAILIAN_API_KEY=sk-sp-your-token-plan-key-here
ALIYUN_BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 可选模型（实测延迟/质量）:
#   qwen3.8-flash     9s 量级，首发首选（订阅模型，名字以官方为准）
#   deepseek-v3-flash 抖动较大 4-35s，不稳定
ALIYUN_BAILIAN_MODEL=qwen3.8-flash

# ---- 豆包 (火山引擎) 配置 ----
# 申请地址: https://www.volcengine.com/product/doubao
DOUBAO_API_KEY=your-doubao-key-here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-32k

# ---- MiniMax (MiniMax Token Plan 订阅 Key) 配置 ----
# 订阅管理: https://platform.minimaxi.com/user-center/payment/token-plan
# API 文档: https://platform.minimaxi.com/docs/llms.txt
# ⚠️ Token Plan 订阅 Key 只能用国内端点 api.minimaxi.com，国际端点 api.minimax.io 会 401
# ⚠️ 订阅 Key 与按量计费 API Key 不互通
# 兼容 OpenAI 协议: base_url=https://api.minimaxi.com/v1, endpoint=/chat/completions
# 鉴权: Authorization: Bearer <订阅 Key>
# 用量查询: GET https://www.minimaxi.com/v1/token_plan/remains
# 可选模型:
#   MiniMax-M3              最新一代, 1M 上下文, 思考增强 (coding/agentic SOTA)
#   MiniMax-M2.7-highspeed  M2.7 高速版, ~100 tps, 性价比高 (明代科普推荐)
#   MiniMax-M2-her          对话/角色扮演场景
MINIMAX_API_KEY=sk-cp-your-token-plan-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# ---- 通用配置 ----
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
APP_HOST=0.0.0.0
APP_PORT=8000